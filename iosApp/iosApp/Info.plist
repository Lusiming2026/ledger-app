<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	<key>CFBundleDisplayName</key>
	<string>记账</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>

	<!-- 启动屏：用空的 UILaunchScreen 让系统走「纯色 + 状态栏」的默认形态。
	     P01 的 Logo 动画由 RootView 自己渲染，不占用启动屏资源。 -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>

	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Automatic</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>

	<!-- 桌面长按图标 → 「记一笔」（P03 快捷入口）。
	     注：冷启动时该 action 走 UIApplicationLaunchOptionsShortcutItemKey，
	     SwiftUI 的 App 生命周期拿不到（详见 LedgerApp.swift 的注释），
	     因此当前只在 App 已在运行时生效。 -->
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>com.ledger.ios.record</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>记一笔</string>
			<key>UIApplicationShortcutItemIconType</key>
			<string>UIApplicationShortcutIconTypeCompose</string>
		</dict>
	</array>

	<!-- 出口合规：本 App 的加密（AES-256-GCM / PBKDF2）全部通过系统框架（CryptoKit）
	     实现，且仅用于本机数据的静态存储，不经由网络传输。按 Apple 的判定属于豁免情形。 -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- 备份文件类型：让「文件」App 与其它 App 分享菜单能识别 .enc 备份 -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.ledger.encrypted-backup</string>
			<key>UTTypeDescription</key>
			<string>记账加密备份</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>enc</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>记账加密备份</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.ledger.encrypted-backup</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
